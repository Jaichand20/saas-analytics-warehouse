table cohort_retention
	lineageTag: 8603c320-75fa-427c-9a93-2ae00dd7ee75

	measure 'Retention % (Month N)' = CALCULATE(AVERAGE(cohort_retention[retention_pct]), cohort_retention[months_since_signup] = SELECTEDVALUE(cohort_retention[months_since_signup]))
		lineageTag: 9a1b2c3d-4e5f-4066-8a2b-3c4d5e6f7086

	column cohort_month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 5142f242-712f-4c3c-a6d7-ce12ff5a621a
		summarizeBy: none
		sourceColumn: cohort_month

		variation Variation
			isDefault
			relationship: 10a7b2be-26a4-4de3-a17e-68bab45710e7
			defaultHierarchy: LocalDateTable_3ad287e8-7c83-4027-93b2-41934c4e13bd.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column months_since_signup
