		formatString: 0
		lineageTag: 44cd6033-175a-4867-85e4-d8aa458f065c
		summarizeBy: sum
		sourceColumn: active_accounts

		annotation SummarizationSetBy = Automatic

	column retention_pct
		dataType: double
		lineageTag: 4a40d6c9-70df-4ea1-911c-d5a6a7faf260
		summarizeBy: sum
		sourceColumn: retention_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition cohort_retention = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([Implementation="2.0"]),
