		lineageTag: 7e52e3a9-b627-486d-8c76-19b632a7eab2
		summarizeBy: sum
		sourceColumn: net_new_mrr

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column mom_growth_pct
		dataType: double
		lineageTag: 8192cea5-9c2a-43a5-a742-ff3baa8754b5
		summarizeBy: sum
		sourceColumn: mom_growth_pct

		annotation SummarizationSetBy = Automatic

