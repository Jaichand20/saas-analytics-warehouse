table churn_risk_accounts
	lineageTag: 8f09c76f-1261-4843-9c2c-bc078a31c6d9

	measure 'High Risk Accounts' = CALCULATE(COUNTROWS(churn_risk_accounts), churn_risk_accounts[is_high_risk] = TRUE())
		lineageTag: 9a1b2c3d-4e5f-4063-8a2b-3c4d5e6f7083

	measure 'Churn Rate %' = DIVIDE([High Risk Accounts], COUNTROWS(churn_risk_accounts)) * 100
		lineageTag: 9a1b2c3d-4e5f-4064-8a2b-3c4d5e6f7084

